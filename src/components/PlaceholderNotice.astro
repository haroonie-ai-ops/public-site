---
// Visible, auditable marker for pages that do not yet carry final copy.
// REQ-001 §1.3: no placeholder may reach production. This component makes
// that easy to grep for (`PlaceholderNotice`) and easy to see on the page.
---

<p class="placeholder-notice" data-placeholder="true">
	<strong>Placeholder —</strong> final content pending (Wave 2 / REQ-001 §4
	owner-supplied copy). Not for production.
</p>

<style>
	.placeholder-notice {
		border: 1px dashed #b45309;
		background: #fffbeb;
		color: #7c2d12;
		padding: 0.75rem 1rem;
		border-radius: 0.25rem;
		font-size: 0.9rem;
	}
</style>
