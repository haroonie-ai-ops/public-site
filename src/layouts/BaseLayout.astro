---
// Shared shell for every page: <head> boilerplate (via SeoHead, R-4.1),
// skip link, header nav (R-2.7), footer (R-2.5 AC2 / R-2.7 AC2).
//
// `title` and `description` are required with no default: every page that
// uses this layout must supply its own unique values (R-4.1 AC1). This is
// deliberate — see src/components/SeoHead.astro for the rationale. Optional
// SEO overrides (ogType, ogImage) and structured data pass straight through.
import SeoHead from '../components/SeoHead.astro';
import type { Props as SeoHeadProps } from '../components/SeoHead.astro';

export interface Props extends SeoHeadProps {}

const { title, description, ogType, ogImage } = Astro.props;

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/services/', label: 'Services' },
	{ href: '/about/', label: 'About' },
	{ href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const year = new Date().getFullYear();

// --------------------------------------------------------------------------
// Brand foundation. This is Astro frontmatter and is NEVER emitted to the
// client - deliberately. The QA-004 regression test in seo-preview.spec.ts
// fails the build if a program document ID reaches shipped HTML, and an
// earlier draft of this change put these notes in HTML and CSS comments:
// that test caught the leak in the built output, which is exactly the class
// of defect it was written for. Internal IDs belong here only.
//
// TYPOGRAPHY. Manrope is self-hosted from public/fonts as a single variable
// woff2 - 24KB covers the whole 200-800 axis, so weights 400/700/800 cost
// one request. Self-hosting is deliberate: Google Fonts would require
// widening BOTH style-src and font-src, two directives and neither of them
// script-src, which U16 rules out. font-src 'self' already permits a
// same-origin font, so the CSP is untouched. The SIL OFL 1.1 licence ships
// alongside the font at public/fonts/manrope-OFL.txt.
//
// The preload carries crossorigin even though the font is same-origin: font
// fetches are CORS-mode, so a preload without it is discarded and the file
// is fetched twice.
//
// TOKENS. :root is the single source for every brand value; no component
// declares a raw colour or font-family. Contrast against white:
//   --brand-navy   12.40:1  any text, including AAA
//   --brand-royal   5.56:1  body text, links, solid buttons with white labels
//   --brand-bright  3.62:1  LARGE text and non-text UI only
//   --brand-light   2.20:1  decoration only, never text
//
// CONTRAST, learned the hard way in this very change: .brand-dot (the ".ai")
// was first set in --brand-bright, matching the brand sheet. axe failed it on
// all six routes in both engines. At 18px bold the wordmark is 13.5pt, just
// under WCAG's 14pt-bold large-text threshold, so it needs 4.5:1 and reaches
// only 3.61:1. It now uses --brand-royal at 5.56:1, visually near-identical
// and conforming. This is precisely the "one token between conforming and
// not" case the amendment warned about; --brand-bright stays valid for
// genuinely large display type.
//
// HEADER (owner decision, 2026-09-17). The header pairs the logo MARK with
// the wordmark as real HTML text rather than one lockup SVG: the text stays
// selectable, translatable and sharp at any zoom, and the link's accessible
// name comes from the text itself, so it is satisfied by the markup rather
// than worked around with aria-label. It also sidesteps a defect in the
// supplied lockups - SVG referenced via <img> cannot load external fonts, so
// a lockup would have rendered the wordmark in a fallback face.
//
// The mark carries explicit width/height (intrinsic 120x120) so its box is
// reserved before load and the header cannot shift.
//
// THEME. color-scheme was "light dark", which advertised a dark mode this
// build never had - --paper was hard-coded #ffffff regardless. MVP is
// light-only, so the declaration now matches reality.
//
// ICONS. The icon set replaces the Astro starter favicon.svg AND a
// favicon.ico that was, despite its extension, a PNG - both shipped
// unchanged since the layout shell landed.
// --------------------------------------------------------------------------
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/brand/haroonie-logo-mark.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/fonts/manrope-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<SeoHead
			title={title}
			description={description}
			ogType={ogType}
			ogImage={ogImage}
		/>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<header>
			<div class="wrap header-inner">
				<a class="brand" href="/">
					<img
						class="brand-mark"
						src="/brand/haroonie-logo-mark.svg"
						alt=""
						width="120"
						height="120"
						decoding="async"
					/>
					<span class="wordmark">haroonie<span class="brand-dot">.ai</span></span>
				</a>
				<nav aria-label="Primary">
					<ul>
						{
							navLinks.map((link) => (
								<li>
									<a
										href={link.href}
										aria-current={isCurrent(link.href) ? 'page' : undefined}
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main-content">
			<div class="wrap">
				<slot />
			</div>
		</main>

		<footer>
			<div class="wrap footer-inner">
				<p>&copy; {year} haroonie.ai. All rights reserved.</p>
				<nav aria-label="Legal">
					<ul>
						<li><a href="/privacy/">Privacy</a></li>
						<li><a href="/terms/">Terms</a></li>
					</ul>
				</nav>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Manrope';
		src: url('/fonts/manrope-variable.woff2') format('woff2');
		font-weight: 200 800;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--brand-navy: #0a2a87;
		--brand-royal: #155bef;
		--brand-bright: #2e83ff;
		--brand-light: #66b4ff;
		--brand-bg: #f5f8ff;

		--font-sans: 'Manrope', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--weight-body: 400;
		--weight-heading: 700;
		--weight-logo: 800;
	}
</style>

<style>
	:root {
		color-scheme: light;
		--ink: #14171a;
		--paper: #ffffff;
		--muted: #5b6470;
		--accent: var(--brand-royal);
		--border: #e2e5ea;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		font-family: var(--font-sans);
		font-weight: var(--weight-body);
		color: var(--ink);
		background: var(--paper);
		display: flex;
		min-height: 100vh;
		flex-direction: column;
		line-height: 1.5;
	}

	.wrap {
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		background: var(--accent);
		color: #fff;
		padding: 0.75rem 1rem;
		z-index: 100;
	}

	.skip-link:focus {
		left: 0.5rem;
		top: 0.5rem;
	}

	header {
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1rem;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--brand-navy);
	}

	.brand-mark {
		width: 1.75rem;
		height: 1.75rem;
		flex: none;
	}

	.wordmark {
		font-weight: var(--weight-logo);
		font-size: 1.125rem;
		letter-spacing: -0.01em;
		color: var(--brand-navy);
	}

	.brand-dot {
		color: var(--brand-royal);
	}

	nav ul {
		list-style: none;
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}

	nav a {
		color: var(--ink);
		text-decoration: none;
	}

	nav a:hover,
	nav a:focus-visible {
		text-decoration: underline;
	}

	/*
	 * Current-page indication must not rely on colour alone (R-5.1 AC1/AC3
	 * and the "not by colour alone" note in PLAN-001). aria-current="page"
	 * carries the semantic signal for assistive tech; font-weight and the
	 * underline carry it visually for sighted users regardless of colour
	 * perception.
	 */
	nav a[aria-current='page'] {
		color: var(--accent);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	main {
		flex: 1;
		padding-block: 2.5rem;
	}

	footer {
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.875rem;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1.5rem;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-inner nav ul {
		gap: 1rem;
	}

	.footer-inner a {
		color: var(--muted);
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>
