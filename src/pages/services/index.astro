---
// Services (REQ-001 R-2.2). Entries come from the `services` content
// collection (R-2.8): between two and six Markdown files under
// src/content/services/, each rendered with its title (frontmatter
// heading) and body (description). Adding, removing or editing a service
// is a Markdown-only change — this file never hard-codes an entry.
//
// BRAND APPLICATION (R-9.1, R-9.4, R-9.5). Each entry is a card with a
// decorative gradient bar across its top edge. That bar is the only place
// --accent-decor / --accent-decor-soft appear on this page: it carries no
// text and no meaning, so the 3.62:1 and 2.20:1 ratios that bar those two
// colours from body text do not apply to it. Headings are --brand-navy at
// 12.40:1 and descriptions inherit --ink at 17.99:1.
//
// The grid is auto-fit rather than a fixed three columns deliberately —
// the collection is defined as two to six entries, so a layout pinned to
// today's three would break the moment a fourth Markdown file lands, which
// is exactly the coupling R-2.8 exists to prevent.
//
// SERVICE ICONS. Supplied 2026-09-18 (E17 item (e)) and now rendered. Which
// icon an entry gets is declared in its own Markdown frontmatter, not mapped
// from `order` here, so adding a service remains a Markdown-only change —
// the same reasoning that makes the grid auto-fit rather than three fixed
// columns.
//
// The icon is decorative and additive: it repeats what the adjacent heading
// already says, carries no information of its own, and is hidden from
// assistive technology by ServiceIcon.astro. An entry that declares no icon
// still renders correctly, which is the AC4 case — the cards were complete
// without icons and remain so.
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderNotice from '../../components/PlaceholderNotice.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const anyPlaceholder = services.some((entry) => entry.data.placeholder);

const pageMeta = await getEntry('pages', 'services');
if (!pageMeta) throw new Error('Missing required "pages/services" content collection entry.');

const rendered = await Promise.all(
	services.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="Services — haroonie.ai" description={pageMeta.data.metaDescription}>
	<span class="accent-rule" aria-hidden="true"></span>
	<h1>Services</h1>

	{anyPlaceholder && <PlaceholderNotice />}

	<ul class="service-list">
		{
			rendered.map(({ entry, Content }) => (
				<li class="service-entry">
					<span class="service-entry-bar" aria-hidden="true" />
					{entry.data.icon && <ServiceIcon name={entry.data.icon} />}
					<h2>{entry.data.title}</h2>
					<Content />
				</li>
			))
		}
	</ul>

	<p class="cta-block">
		<a class="btn" href="/contact/">Discuss your project</a>
	</p>
</BaseLayout>

<style>
	h1 {
		margin-block-start: var(--space-md);
	}

	.service-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: none;
		display: grid;
		gap: var(--space-md);
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		margin-block: var(--space-xl) var(--space-section);
	}

	.service-entry {
		position: relative;
		margin: 0;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		padding: clamp(1.25rem, 3vw, 1.75rem);
		box-shadow: var(--shadow-sm);
		transition:
			border-color var(--transition),
			box-shadow var(--transition);
	}

	.service-entry:hover {
		border-color: var(--accent-decor);
		box-shadow: var(--shadow-md);
	}

	/* Decoration only — see this file's frontmatter note on why the two
	   low-contrast brand colours are allowed here and nowhere else. */
	.service-entry-bar {
		position: absolute;
		inset-block-start: 0;
		inset-inline: 0;
		height: 0.25rem;
		background: linear-gradient(
			90deg,
			var(--accent) 0%,
			var(--accent-decor) 55%,
			var(--accent-decor-soft) 100%
		);
	}

	.service-entry h2 {
		margin-block: 0 var(--space-2xs);
		font-size: var(--text-lg);
	}

	.service-entry :global(p) {
		margin-block: 0;
		max-width: none;
		color: var(--ink-muted);
	}

	.cta-block {
		margin: 0;
		max-width: none;
		padding-block-start: var(--space-lg);
		border-block-start: 1px solid var(--line);
	}
</style>
