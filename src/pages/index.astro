---
// Home (REQ-001 R-2.1). All copy is sourced from the `home` content
// collection (R-2.8) — this file contains no hard-coded body copy, only
// structural markup and the single-CTA wiring R-2.1 AC2 requires.
//
// BRAND APPLICATION (R-9.1, R-9.5). Everything below references the token
// source in BaseLayout.astro; there is no colour, family or size literal
// here. Two contrast decisions worth recording:
//
//  1. The hero sits on a gradient, and R-9.5 AC3 requires text over a
//     gradient to be measured against the actual pixels behind it at every
//     width — a rule written for photographs, where the answer genuinely
//     differs per width. It is satisfied here by construction instead of by
//     measurement: both stops are known, flat brand surfaces (--paper and
//     --surface-subtle), so the worst case behind any glyph is #f5f8ff, and
//     every foreground used on it clears AA against that exact value —
//     navy 11.66:1, --ink-muted 6.54:1, --link 5.23:1. Nothing about that
//     changes when the gradient crops differently at 320px or 1920px.
//  2. The CTA is a solid --accent (Royal) fill with a white label at
//     5.56:1. The same button in --accent-decor (Bright) would be 3.62:1
//     and fail R-9.5 AC2 — a one-token difference between conforming and
//     not, which is why the fill is never wired to the decorative token.
//
// The heading keeps the approved copy exactly. The supplied artwork's
// `IDEAS -> SOLUTIONS -> IMPACT` tagline is NOT rendered here: it is
// permitted only inside the logo artwork it is drawn into, never as a
// free-standing strapline (REQ-001-A3 section 4.4).
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderNotice from '../components/PlaceholderNotice.astro';
import OrganizationSchema from '../components/OrganizationSchema.astro';

const home = await getEntry('home', 'index');
if (!home) throw new Error('Missing required "home" content collection entry.');
const { heading, subheading, ctaLabel, ctaHref, servicesSummary, servicesSummaryLinkLabel, metaDescription, placeholder } = home.data;
---

<BaseLayout title="haroonie.ai — Tech Consulting" description={metaDescription}>
	<Fragment slot="head">
		<OrganizationSchema name="haroonie.ai" description={metaDescription} />
	</Fragment>

	{placeholder && <PlaceholderNotice />}

	<section class="hero">
		<span class="accent-rule" aria-hidden="true"></span>
		<h1>{heading}</h1>
		<p class="lede">{subheading}</p>
		<a class="btn" href={ctaHref}>{ctaLabel}</a>
	</section>

	<section class="services-summary" aria-labelledby="services-summary-heading">
		<h2 id="services-summary-heading">What we do</h2>
		<p>
			{servicesSummary}
			{' '}
			<a href="/services/">{servicesSummaryLinkLabel}</a>
		</p>
	</section>
</BaseLayout>

<style>
	.hero {
		background: linear-gradient(145deg, var(--surface-subtle) 0%, var(--paper) 72%);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		padding: clamp(1.75rem, 5vw, 3.5rem) clamp(1.75rem, 5vw, 3.5rem)
			clamp(2rem, 6vw, 4rem);
	}

	.hero h1 {
		font-size: var(--text-3xl);
		margin-block: var(--space-md) var(--space-sm);
		/* No width cap: at the display size the approved headline very nearly
		   fills the panel, and capping it produced a narrow ragged column
		   inside a wide box. text-wrap: balance (set globally) evens the two
		   lines it does take at mid widths. */
		max-width: none;
	}

	.hero .lede {
		font-size: var(--text-lg);
		margin-block-end: var(--space-lg);
	}

	.services-summary {
		margin-block-start: var(--space-section);
	}

	.services-summary h2 {
		margin-block-start: 0;
	}

	.services-summary p {
		font-size: var(--text-md);
		color: var(--ink-muted);
	}

	/* The inline link inside a muted paragraph must still meet 4.5:1 in its
	   own right (R-9.5 AC1) — it does, at 5.56:1, and is underlined so it is
	   not distinguished from the surrounding text by colour alone. */
	.services-summary p a {
		font-weight: var(--weight-bold);
	}
</style>
