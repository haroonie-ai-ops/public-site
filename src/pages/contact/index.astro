---
// Contact (REQ-001 R-2.4). Email, phone, booking link and intro copy come
// from the `contact` content collection (R-2.8). The enquiry form below is
// markup only per this wave's scope (R-2.4 AC2) — it has no `action`, no
// `method`, no submit handler and no client-side validation. Wiring it up
// (R-3.1) is Wave 5, blocked on E4 (a transactional email credential); do
// not add validation, an action endpoint, or a submit handler here.
//
// Booking link (2026-09-17): rendered only when both `bookingUrl` and
// `bookingLabel` are set. They are currently unset — R-2.4 AC1's
// booking-link clause is under an explicit interim owner waiver (REQ-001
// R-2.4), because no scheduling account exists and the reserved `/booking`
// path 404s. A dead link failed AC1's "actionable" requirement anyway, so
// no link is rendered rather than a broken one. Setting both fields in the
// content file restores it with no change here.
//
// QA-004-class remediation (sweep, PRODUCT_DEFECT, High): this note used
// to also live as a raw HTML comment in the markup below, which — unlike
// this frontmatter comment — compiles straight into the shipped HTML and
// is visible to anyone who views page source. Removed from the markup;
// this frontmatter comment (never emitted to output) is now the only copy.
//
// --------------------------------------------------------------------------
// BRAND APPLICATION (R-9.1, R-9.5). Two things on this page are contrast
// decisions rather than styling preferences:
//
//  1. FORM-FIELD BORDERS. R-9.5 AC4 makes a field border informative
//     non-text UI, owing 3:1 against its adjacent background. The border
//     these inputs carried before this change was the site's single
//     --border value, #e2e5ea, which is 1.26:1 against white — roughly a
//     third of what AC4 requires. It was invisible to the suite because
//     axe cannot compute SC 1.4.11 for an arbitrary border, so nothing
//     failed; the ratio simply had to be worked out. They now use
//     --line-strong (#6e7c97, 4.21:1 against white, 3.96:1 against
//     --surface-subtle), which clears AC4 on both surfaces this page uses.
//     The purely decorative hairlines elsewhere keep the soft --line: a
//     divider that conveys nothing does not owe 3:1, and holding every
//     rule on the page to a contrast built for controls would make the
//     page louder without making it more accessible.
//  2. THE DISABLED SUBMIT BUTTON. axe skips disabled controls for
//     contrast, so this one is unscored either way. It is still set at
//     --ink-muted on --surface-subtle (6.54:1), because "the suite will
//     not check it" is not a reason to ship text a visitor cannot read —
//     and its label states why it is disabled, so the state is carried by
//     text and not by the greying alone.
//
// The method list is styled as rows rather than bullets, but stays a real
// <ul> of <li>s: the list semantics are what tell a screen reader how many
// ways there are to make contact, and restyling must not cost that.
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const contact = await getEntry('contact', 'index');
if (!contact) throw new Error('Missing required "contact" content collection entry.');
const { heading, email, phone, phoneDisplay, bookingUrl, bookingLabel, formIntro, metaDescription } = contact.data;
---

<BaseLayout title="Contact — haroonie.ai" description={metaDescription}>
	<span class="accent-rule" aria-hidden="true"></span>
	<h1>{heading}</h1>

	<div class="contact-grid">
		<section class="contact-methods" aria-labelledby="contact-methods-heading">
			<h2 id="contact-methods-heading">Get in touch directly</h2>
			<ul>
				<li>
					<span class="method-label">Email</span>
					<a class="method-value" href={`mailto:${email}`}>{email}</a>
				</li>
				{phone && phoneDisplay && (
					<li>
						<span class="method-label">Phone</span>
						<a class="method-value" href={`tel:${phone}`}>{phoneDisplay}</a>
					</li>
				)}
				{bookingUrl && bookingLabel && (
					<li>
						{/* No label span here on purpose: bookingLabel is itself the
						    owner-supplied phrase for this row, and inventing a second
						    label to sit above it would be new visitor-facing copy. */}
						<a class="method-value" href={bookingUrl} target="_blank" rel="noopener noreferrer">{bookingLabel}</a>
					</li>
				)}
			</ul>
		</section>

		<section class="contact-form" aria-labelledby="contact-form-heading">
			<h2 id="contact-form-heading">Send a message</h2>
			<p class="form-intro">{formIntro}</p>

			<form novalidate aria-describedby="contact-form-heading">
				<div class="field">
					<label for="contact-name">Name</label>
					<input id="contact-name" name="name" type="text" autocomplete="name" />
				</div>
				<div class="field">
					<label for="contact-email">Email</label>
					<input id="contact-email" name="email" type="email" autocomplete="email" />
				</div>
				<div class="field">
					<label for="contact-message">Message</label>
					<textarea id="contact-message" name="message" rows="6"></textarea>
				</div>
				<button type="submit" disabled>
					Send message (coming soon — email us directly meanwhile)
				</button>
			</form>
		</section>
	</div>
</BaseLayout>

<style>
	h1 {
		margin-block-start: var(--space-md);
	}

	.contact-grid {
		display: grid;
		gap: var(--space-xl);
		align-items: start;
		margin-block-start: var(--space-xl);
	}

	@media (min-width: 60rem) {
		.contact-grid {
			grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
			gap: var(--space-2xl);
		}
	}

	.contact-methods h2,
	.contact-form h2 {
		margin-block: 0 var(--space-sm);
		font-size: var(--text-lg);
	}

	.contact-methods ul {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: none;
		display: grid;
		gap: var(--space-2xs);
	}

	.contact-methods li {
		margin: 0;
		display: grid;
		gap: var(--space-3xs);
		background: var(--surface-subtle);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: var(--space-xs) var(--space-sm);
	}

	.method-label {
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--ink-muted);
	}

	.method-value {
		font-size: var(--text-md);
		font-weight: var(--weight-bold);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.method-value:hover,
	.method-value:focus-visible {
		text-decoration: underline;
	}

	.form-intro {
		color: var(--ink-muted);
		margin-block-end: var(--space-md);
	}

	form {
		max-width: 34rem;
		display: grid;
		gap: var(--space-sm);
	}

	.field {
		display: grid;
		gap: var(--space-3xs);
	}

	label {
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		color: var(--heading);
	}

	input,
	textarea {
		font: inherit;
		color: var(--ink);
		background: var(--surface);
		padding: var(--space-2xs) var(--space-xs);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		transition:
			border-color var(--transition),
			box-shadow var(--transition);
	}

	input:hover,
	textarea:hover {
		border-color: var(--accent);
	}

	input:focus-visible,
	textarea:focus-visible {
		border-color: var(--accent);
		outline-offset: 0;
	}

	textarea {
		resize: vertical;
		min-height: 8rem;
	}

	button[type='submit'] {
		justify-self: start;
		font: inherit;
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		text-align: start;
		padding: var(--space-2xs) var(--space-sm);
		border-radius: var(--radius-pill);
		border: 1px dashed var(--line-strong);
		background: var(--surface-subtle);
		color: var(--ink-muted);
		cursor: not-allowed;
	}
</style>
